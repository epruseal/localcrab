# ─────────────────────────────────────────────
# OpenCrab Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Storage Mode ──────────────────────────────
# "local"  → no Docker needed (SQLite + ChromaDB/sqlite-vec embedded)
# "docker" → full services via docker-compose up -d (Neo4j+MongoDB+Postgres+Chroma)
# "kuzu"   → local variant, KuzuGraphStore (ladybug) instead of SQLite graph
# "pg"     → PG-unified: 4스토어(graph/doc/sql/vector) 전부 PostgreSQL 한 서버.
#            MVCC 다중 라이터가 필요한 운영에 권장(§9 힌지 — 상세:
#            docs/pgvector-migration-plan.md (B) 경로, docs/vector-backends.md).
#            설치: pip install ".[pg]" (pgvector 패키지). 아래 STORAGE_MODE=pg
#            블록의 POSTGRES_URL / PG_EF_SEARCH 참고.
STORAGE_MODE=local

# Local data directory (used in local mode)
LOCAL_DATA_DIR=/home/asdf/.openclaw/workspace/data/localcrab

# ── Docker Mode Only ──────────────────────────
# (ignored when STORAGE_MODE=local)

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=opencrab

# MongoDB
MONGODB_URI=mongodb://root:opencrab@localhost:27017
MONGODB_DB=opencrab

# PostgreSQL
POSTGRES_URL=postgresql://opencrab:opencrab@localhost:5432/opencrab

# ── STORAGE_MODE=pg 전용 예시 (PG-unified, 4스토어 전부 PostgreSQL) ──
# STORAGE_MODE=pg
# POSTGRES_URL=postgresql://opencrab:opencrab@localhost:5432/opencrab
# pgvector HNSW 쿼리 세션 파라미터(hnsw.ef_search). 기본 150 — recall 0.95
# 경계에 여유 마진을 둔 값(프리플라이트 실측). 설계: pgvector-migration-plan.md.
# PG_EF_SEARCH=150

# ChromaDB (docker server)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=opencrab_vectors

# ── Vector Store Backend ──────────────────────
# 벡터 스토어 백엔드 선택(임베딩 백엔드와 독립 축).
#   "chroma"     : ChromaDB. 기존 동작 100% 보존.
#   "sqlite-vec" : sqlite-vec(vec0). 4스토어를 단일 SQLite WAL 규율로 통일
#                  (Chroma 다중프로세스 쓰기 제약/flock 층 제거). KURE(1024d) 표준
#                  — EMBEDDING_BACKEND=openai 의 KURE EF 로 앱이 직접 임베딩.
#   "pgvector"   : pgvector(PostgreSQL 확장). STORAGE_MODE=pg 이면 자동 선택.
#                  local 모드에서도 명시하면 벡터만 PG 로 보낼 수 있음(§6.3 (C)).
#
# 미설정 시 조건부 기본값:
#   STORAGE_MODE=local/kuzu + EMBEDDING_BACKEND=openai(기본) → sqlite-vec
#   STORAGE_MODE=docker 이거나 EMBEDDING_BACKEND=local(minilm)  → chroma
# 명시 설정은 항상 우선. VECTOR_BACKEND=sqlite-vec + EMBEDDING_BACKEND=local 조합은
# 기동 시 ValueError(minilm 384d 미지원).
# 설계: docs/pgvector-migration-plan.md §3.6, 매트릭스: docs/vector-backends.md.
# 롤백은 아래 줄 주석을 해제해 chroma 로 강제 전환하면 됨(비파괴).
# VECTOR_BACKEND=chroma
# sqlite-vec 벡터 DB 파일명(LOCAL_DATA_DIR 하위) 및 vec0 테이블명.
VECTOR_DB_FILE=vectors.db
VECTOR_COLLECTION=vectors_kure

# 벡터 ANN 가속(sqlite-vec 전용, 기본 off). "binary" = 전역(pack 미지정) 검색을
# binary 2단계 양자화(bit hamming coarse → float cosine rerank)로 가속.
# 기존 DB 는 scripts/migrate_add_binary_quantization.py 로 bit 컬럼 backfill 필요.
# 상세: docs/vector-backends.md §4.1, docs/pgvector-migration-plan.md §3.7.
# VECTOR_ANN=binary
# coarse 후보 수 C (recall 튜닝 노브, ≤4096).
# VECTOR_ANN_COARSE_K=512

# ── Embedding Backend ─────────────────────────
# EMBEDDING_BACKEND=openai(기본): OpenAI 호환 서버(LM Studio 등) primary +
# 로컬 GGUF 자동다운로드 fallback. EMBEDDING_BACKEND=local: minilm(384d) 롤백.
# EMBEDDING_BACKEND=local
#
# OpenAI 호환 서버 주소. 콤마로 여러 URL 을 나열하면 순서대로 시도되는
# 체인이 된다(첫 서버가 죽으면 다음 서버, 전부 죽으면 로컬 GGUF 폴백).
# 단일 URL 만 넣으면 기존과 동일하게 동작(하위호환).
# OPENAI_API_BASE=http://localhost:1234/v1
# 다중 원격 예시:
# OPENAI_API_BASE=http://embed-host-1:1234/v1,http://embed-host-2:1234/v1
# OPENAI_EMBED_MODEL=text-embedding-kure-v1
# EMBED_DIM=1024

# ── MCP ───────────────────────────────────────
MCP_SERVER_NAME=localcrab
MCP_SERVER_VERSION=0.1.0-localcrab
# HTTP transport (opencrab serve --transport http). 신뢰망 노출은 0.0.0.0.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# 인증 토큰은 여기 두지 않는다 — --auth-token-file 또는
# LOCALCRAB_MCP_TOKEN / LOCALCRAB_MCP_TOKEN_FILE 로 주입(평문 노출 방지).
# 클라이언트는 Authorization: Bearer <token> 헤더 또는 /mcp?token=<token>
# 쿼리 param 중 하나로 인증한다(같은 토큰). param은 로그에 노출될 수 있어 헤더 우선.

# Logging
LOG_LEVEL=INFO
